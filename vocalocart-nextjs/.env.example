# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Neon (https://neon.tech) or Supabase
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
# Full URL of your app (http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"
# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Get from https://resend.com → API Keys
# Used for: contact form emails, order confirmation emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The "from" address — must be a verified domain in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"
# Where contact form submissions are forwarded
SUPPORT_EMAIL="support@yourdomain.com"

# ─── Stripe (Phase 4 — not needed until payment is implemented) ────────────────
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
# Must be NEXT_PUBLIC_-prefixed since it's read in a client component (checkout page)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret — from Stripe CLI or dashboard webhook settings
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# ─── Vercel Blob (Phase 4 — not needed until image upload is implemented) ──────
# Automatically set when you add Vercel Blob storage to your project
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxxxxxxxxxxxxxx"
